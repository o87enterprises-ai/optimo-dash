{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../core/**/*.ts",
    "../../adapters/**/*.ts"
  ]
}