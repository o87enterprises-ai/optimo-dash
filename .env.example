# ---------------------------------------------------------------------------
# Self-hosted deployment (Termux, VPS, Docker).
#
# On Cloudflare Pages none of this lives in a file: bindings go in
# wrangler.toml and secrets are set with `wrangler pages secret put NAME`.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Storage
DATABASE_URL=postgresql://REPLACE_ME@localhost:5432/seo_aeo_geo
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security — required
# ---------------------------------------------------------------------------

# Encrypts API keys before they are stored. Generate with:
#   openssl rand -base64 32
# Changing it makes every stored key undecryptable, so back it up.
ENCRYPTION_KEY=

# Optional but strongly recommended for any deployment reachable from the
# internet: required to create the admin account, which closes the first-run
# race where a stranger could claim the account before you do.
#   openssl rand -hex 16
SETUP_TOKEN=

# Set to 1 to let anonymous visitors read the dashboard. Off by default —
# your rankings, prompts and competitor analysis are otherwise visible to
# anyone who finds the URL.
# PUBLIC_READS=0

# Lowers the password hashing work factor. Only set this if your runtime
# cannot afford the default; it weakens resistance to offline cracking.
# PBKDF2_ITERATIONS=600000

# Pages crawled per clone run. Lower it on constrained runtimes.
# CLONE_MAX_PAGES=25

# ---------------------------------------------------------------------------
# API keys — all optional.
#
# You do NOT need to set these here. The Settings page stores them encrypted
# in the database, which is the recommended route. A value set here acts as a
# deployment default and is shown as read-only in the UI.
# ---------------------------------------------------------------------------

# LLM visibility (GEO)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# SEO data
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
BING_WEBMASTER_API_KEY=

# Backlinks
AHREFS_API_KEY=
SEMRUSH_API_KEY=
MOZ_API_KEY=

# Reviews
GOOGLE_BUSINESS_API_KEY=
TRUSTPILOT_API_KEY=
G2_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=
