# Core
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://REPLACE_ME@localhost:5432/seo_aeo_geo
# docker-compose publishes Redis on host port 6380 (6379 is often taken)
REDIS_URL=redis://localhost:6380

# LLM visibility (GEO) — a provider is enabled when its key/model is set.
# Models are optional (sensible defaults); override any *_MODEL to change it.
NVIDIA_API_KEY=                 # build.nvidia.com (nvapi-...)
# NVIDIA_MODEL=google/gemma-3-12b-it   # NVIDIA retires models; use Autopilot's "List models" to see current ones
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_AI_API_KEY=              # Gemini; answers are web-grounded, so sources can be cited
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_GROUNDING=false        # turn off Google Search grounding

# Ollama (local): auto-detected; uses the first pulled model unless OLLAMA_MODEL is set
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# Ollama (cloud)
OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=

# Any other OpenAI-compatible endpoint (OpenAI, OpenRouter, LM Studio, vLLM, ...):
# LLM_PROVIDER_<NAME>_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_<NAME>_MODEL=
# LLM_PROVIDER_<NAME>_API_KEY=

# SEO sources
# Search Console: service-account JSON (path or inline JSON), see docs/search-console.md
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# ...or OAuth instead of a service account
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
GA4_PROPERTY_ID=
BING_WEBMASTER_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=
MOZ_API_KEY=

# Reviews / citations
GOOGLE_BUSINESS_API_KEY=
TRUSTPILOT_API_KEY=
G2_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=
SMTP_URL=

# 3D / map (optional)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Autopilot (web /autopilot). On a public deployment, server-side AI keys above are only used
# when a request sends this code; leave unset to require visitors to paste their own key.
# AUTOPILOT_ACCESS_KEY=
